modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm -r --if-present run test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 4015
externalPort = 3002

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 26015
externalPort = 3000

[[ports]]
localPort = 26016
externalPort = 3003

[[ports]]
localPort = 27000
externalPort = 3001

[[ports]]
localPort = 27001
externalPort = 5000

[[ports]]
localPort = 27002
externalPort = 5173

[userenv]

[userenv.shared]
ADMIN_PASSWORD = "Maple2025!Admin"
INDEXNOW_KEY = "110d231bb1bd4ad19397e30c130860f4"

[userenv.development]
RESEND_API_KEY = "REDACTED_RESEND_KEY"

[userenv.production]
RESEND_API_KEY = "REDACTED_RESEND_KEY"

[objectStorage]
defaultBucketID = "replit-objstore-a8ef13b0-f006-4ca0-b05a-aa565a732f54"
