modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 4015
externalPort = 3002

[[ports]]
localPort = 5599
externalPort = 6000

[[ports]]
localPort = 5601
externalPort = 6800

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 26015
externalPort = 3000

[[ports]]
localPort = 26016
externalPort = 3003

[[ports]]
localPort = 27000
externalPort = 3001

[[ports]]
localPort = 27001
externalPort = 5000

[[ports]]
localPort = 27002
externalPort = 5173

[userenv]

[userenv.shared]
ADMIN_PASSWORD = "Maple2025!Admin"

[userenv.development]
RESEND_API_KEY = "REDACTED_RESEND_KEY"

[userenv.production]
RESEND_API_KEY = "REDACTED_RESEND_KEY"
