# Runtime
NODE_ENV=development
API_PORT=8080
WEB_PORT=26015
MOCKUP_PORT=8081
DATABASE_URL=postgresql://user:password@localhost:5432/mapletechie
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-with-a-secure-password

# Cloudflare R2 object storage — development-only bucket and token.
# Railway production uses the separate "mapletechie" bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PRIVATE_OBJECT_DIR=/mapletechie-development/private
PUBLIC_OBJECT_SEARCH_PATHS=/mapletechie-development/covers,/mapletechie-development/public

# Website development
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:8080
API_BASE=http://127.0.0.1:8080
SITE_URL=http://127.0.0.1:26015

# Optional services
RESEND_API_KEY=
AUTOMATION_DRAFT_TOKEN=
MCP_CONNECTOR_TOKEN=