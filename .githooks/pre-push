#!/bin/sh
# The versioned hook preserves the existing Git LFS check and protects origin/main.
set -eu

remote_name=${1:-}
remote_url=${2:-}
refs=$(cat)
printf '%s\n' "$refs" | git lfs pre-push "$remote_name" "$remote_url"

if [ "$remote_name" != origin ]; then
  exit 0
fi

zero=0000000000000000000000000000000000000000
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  [ "$remote_ref" = refs/heads/main ] || continue
  checked=1
  if [ "$local_sha" = "$zero" ] || [ "$remote_sha" = "$zero" ]; then
    echo "Refusing to create or delete origin/main with the direct-push workflow." >&2
    exit 1
  fi
  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    echo "Fetch origin/main before pushing; the remote base commit is not available locally." >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "Refusing a non-fast-forward push to origin/main." >&2
    exit 1
  fi
  if [ -n "${RAILWAY_SCHEMA_REQUIREMENTS:-}" ]; then
    pnpm --filter @workspace/scripts run schema:railway \
      --base "$remote_sha" --head "$local_sha" \
      --requires "$RAILWAY_SCHEMA_REQUIREMENTS" || exit 1
  else
    pnpm --filter @workspace/scripts run schema:railway \
      --base "$remote_sha" --head "$local_sha" || exit 1
  fi
done <<EOF
$refs
EOF

if [ "$checked" -eq 0 ]; then
  echo "No origin/main update in this push; Railway schema gate not needed."
fi